{
  "name": "agent-teams-desktop",
  "private": true,
  "version": "1.1.0-beta.9",
  "description": "Local-first Electron desktop app for configurable AI agent teams, shared memory and MCP tools.",
  "author": "Ben Witt",
  "license": "MIT",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "lint": "oxlint src electron scripts --deny-warnings",
    "test": "npm run lint && npm run test:smoke && npm run test:security && npm run test:review",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:security": "node --test scripts/security-test.cjs",
    "test:review": "node --test scripts/review-environment-test.cjs",
    "audit": "npm audit --audit-level=high",
    "electron": "electron .",
    "dist": "vite build && electron-builder --publish never",
    "dist:win": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "electron-store": "8.2.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.80.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "io.agentteams.desktop",
    "productName": "Agent Teams",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Agent-Teams-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "README.md",
      "PRIVACY.md",
      "SECURITY.md",
      "THREAT_MODEL.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
